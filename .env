# GPU_RUNTIME=nvidia

# 关卡语义复核的可选 LLM（三项全填才启用；不填则走纯 OpenCV 结果）
# export LEVEL_LLM_BASE_URL='https://你的兼容服务.example/v1'
# export LEVEL_LLM_API_KEY='你的密钥'
# export LEVEL_LLM_MODEL='服务商提供的视觉模型名称'

# 对外基址：响应里的 *Url 会拼上它变成完整地址（留空 = 按请求 Host 推导）
PUBLIC_BASE_URL=http://scjjysd.xyz:8000

# 跨域：默认 * 放开所有来源；要携带 Cookie/Authorization 必须配成具体来源并打开凭证开关
# CORS_ALLOW_ORIGINS=https://game.example,https://admin.example
# CORS_ALLOW_CREDENTIALS=true
# CORS_ALLOW_METHODS=GET,POST,OPTIONS
# CORS_ALLOW_HEADERS=Content-Type,X-Trace-Id
# CORS_MAX_AGE=600

# 日志：落 out/logs/<组件>-<日期>.log，按天拆分；LOG_KEEP_DAYS=0 表示永久保留
# LOG_LEVEL=INFO
# LOG_KEEP_DAYS=30
# LOG_CONSOLE=1
